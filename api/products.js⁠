export default async function handler(req, res) {
  res.setHeader('Access-Control-Allow-Origin', '*');
  res.setHeader('Access-Control-Allow-Methods', 'GET');

  try {
    const apiResponse = await fetch('https://api.ics-store.my.id/api/reseller/products', {
      method: 'GET',
      headers: {
        'Authorization': 'Bearer 9f31c11bacdcc071d6d689e21f5cef36417068fe1dd60f8f',
        'Accept': 'application/json',
        'Content-Type': 'application/json'
      }
    });

    const result = await apiResponse.json();
    const listArray = Array.isArray(result.data) ? result.data : [];

    // Filter khusus produk yang berkaitan dengan Akrab / Paket Data XL / Axis
    const filteredList = listArray.filter(item => {
      const name = (item.name || "").toUpperCase();
      const code = (item.code || "").toUpperCase();
      return name.includes("AKRAB") || name.includes("SUPERMINI") || code.includes("PDA") || code.includes("KDA");
    });

    const products = filteredList.map(item => ({
      code: item.code || "-",
      name: item.name || "Produk",
      type: item.category || item.type || "Regular",
      quota: item.description || "-",
      stock: item.stock !== undefined ? item.stock : 0,
      price: item.price || 0,
      status: item.status || "empty"
    }));

    return res.status(200).json(products);
  } catch (err) {
    return res.status(500).json({ error: "Gagal mengambil data", details: err.message });
  }
}
